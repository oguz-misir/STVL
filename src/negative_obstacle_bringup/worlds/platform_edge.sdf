<?xml version="1.0" ?>
<!--
  Gazebo Harmonic platform_edge.sdf
  Platform kenarı (sert düşüş) negatif engel baseline doğrulaması.

  Platform geometrisi (dünya koordinatlarında):
    Platform yüzeyi: z=0, x=[0, 3], y=[-2, 2]
    Platform kenarı: x=3.0 (kameraya göre ~3m ileri)
    Aşağı zemin: z=-0.6 m (60cm düşüş)

  Kamera: x=0.15, z=0.45, pitch=+0.349 rad (~20°, optik eksen ileri+aşağı)

  Çalıştırma:
    DISPLAY=:0 gz sim platform_edge.sdf -r -s

  ROS bridge:
    ros2 run ros_gz_bridge parameter_bridge \
      /camera/depth@sensor_msgs/msg/Image[gz.msgs.Image \
      /camera/camera_info@sensor_msgs/msg/CameraInfo[gz.msgs.CameraInfo
-->
<sdf version="1.9">
  <world name="platform_edge">

    <physics name="default" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Zorunlu world-level pluginler (Gazebo Harmonic) -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Platform yüzeyi: z=0, x=[0, 3], y=[-2, 2] -->
    <model name="platform">
      <static>true</static>
      <pose>1.5 0 -0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.0 4.0 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.0 4.0 0.1</size></box></geometry>
          <material>
            <ambient>0.60 0.60 0.60 1</ambient>
            <diffuse>0.60 0.60 0.60 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Alt zemin: z=-0.6 (60cm düşüş), x=[3, 10] -->
    <model name="lower_ground">
      <static>true</static>
      <pose>6.5 0 -0.65 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>7.0 8.0 0.1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>7.0 8.0 0.1</size></box></geometry>
          <material>
            <ambient>0.40 0.35 0.25 1</ambient>
            <diffuse>0.45 0.40 0.30 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Kamera platformu
      camera_link pose: x=0.15, y=0, z=0.45, pitch=0.349 rad (~20°)
    -->
    <model name="depth_camera_rig">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>

      <link name="base_link">
        <pose>0 0 0.1 0 0 0</pose>
        <inertial>
          <mass>1.0</mass>
          <inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia>
        </inertial>
        <visual name="base_visual">
          <geometry><box><size>0.3 0.3 0.1</size></box></geometry>
          <material><ambient>0.2 0.2 0.8 1</ambient></material>
        </visual>
      </link>

      <link name="camera_link">
        <pose>0.15 0 0.45 0 0.349 0</pose>
        <visual name="camera_visual">
          <geometry><box><size>0.05 0.05 0.03</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material>
        </visual>

        <sensor name="depth_camera" type="depth_camera">
          <update_rate>15</update_rate>
          <always_on>true</always_on>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.2217</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
              <format>R_FLOAT32</format>
            </image>
            <clip>
              <near>0.10</near>
              <far>10.0</far>
            </clip>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>0.01</stddev>
            </noise>
          </camera>
          <topic>camera/depth</topic>
        </sensor>
      </link>

      <joint name="camera_joint" type="fixed">
        <parent>base_link</parent>
        <child>camera_link</child>
      </joint>
    </model>

  </world>
</sdf>
